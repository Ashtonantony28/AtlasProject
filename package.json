{
  "name": "atlas",
  "version": "0.1.0",
  "description": "Local-first codebase intelligence engine: symbol/dependency graph, hybrid search, grounded Q&A, drift detection.",
  "type": "module",
  "bin": {
    "atlas": "./dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "atlas": "node --enable-source-maps ./dist/cli/index.js",
    "atlas:ts": "tsx ./src/cli/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "codebase",
    "intelligence",
    "graph",
    "rag",
    "documentation",
    "search"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "DECISIONS.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^11.5.0",
    "commander": "^12.1.0",
    "ignore": "^6.0.2",
    "sqlite-vec": "^0.1.9",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-python": "0.23.2",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^9.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
